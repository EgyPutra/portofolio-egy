{
  "name": "bisnis-bareng-nuri",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit && tsc -p studio/tsconfig.json --noEmit && tsc -p publication-worker/tsconfig.json --noEmit",
    "lint": "eslint app components lib studio publication-worker scripts tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "studio": "npm run dev --workspace studio",
    "studio:build": "npm run build --workspace studio",
    "prebuild": "node scripts/prepare-build.mjs",
    "seed:studio": "tsx scripts/seed-studio.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tabler/icons-react": "^3.35.0",
    "@tailwindcss/postcss": "^4.1.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@sanity/client": "8.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.14"
  }
